@model SignInModel

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<form class="items" method="post">
	
	<h1 class="CreateAcc"> Login </h1>

	<div class="inputPairs">
		<label asp-for="Email"></label>
		<input asp-for="Email" type="email"/>
		<span asp-validation-for="Email"></span>
	</div>

	<div class="inputPairs">
		<label asp-for="Password"></label>
		<input asp-for="Password" type="password"/>
		<span asp-validation-for="Password"></span>
	</div>

	<div class="checkboxPair">
		<input asp-for="RememberMe" type="checkbox" name="name" value="" />
		<label asp-for="RememberMe"></label>
	</div>
	

	<button class="btn"> Log In </button>


	<div>
		<label>Dont have an account? <a class="textDeco" href="#">Sign Up</a> </label>
	</div>
</form>



@section Scripts {
	<script src="~/js/formvalidation.js"></script>
}
