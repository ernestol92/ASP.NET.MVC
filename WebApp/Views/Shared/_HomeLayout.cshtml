<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/1231eeb30c.js" crossorigin="anonymous"></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

</head>
<body data-page="workspace">

    <div class="MainGrid">
        <div class="SideBar">
			@await Html.PartialAsync("~/Views/Shared/Partials/WorkSpacePartials/_SideBar.cshtml")
        </div>
        <div class="TopBar">
            @await Html.PartialAsync("~/Views/Shared/Partials/WorkSpacePartials/_TopBar.cshtml")
        </div>
        <main>
            @RenderBody()
        </main>
        <div id="projectModal" class="modal">
            @RenderSection("Modals", required: false)
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
    
</body>
</html>
